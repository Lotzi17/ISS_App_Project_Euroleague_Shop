@startuml UC10_ImportProductsCSV_Sequence
skinparam backgroundColor #131313
skinparam sequenceArrowThickness 2
skinparam roundcorner 4
skinparam sequenceParticipantBorderColor #FF6B00
skinparam sequenceParticipantBackgroundColor #1f1f1f
skinparam sequenceParticipantFontColor #e2e2e2
skinparam sequenceParticipantFontStyle Bold
skinparam sequenceActorBorderColor #FF6B00
skinparam sequenceActorBackgroundColor #1f1f1f
skinparam sequenceActorFontColor #e2e2e2
skinparam sequenceArrowColor #FF6B00
skinparam sequenceLifeLineBorderColor #5a4136
skinparam noteBorderColor #FF6B00
skinparam noteBackgroundColor #2a2a2a
skinparam noteFontColor #e2bfb0
skinparam titleFontColor #FF6B00
skinparam titleFontSize 16
skinparam titleFontStyle Bold

title UC10 – Import Products from CSV (Admin)

actor Admin as admin
participant "React\nFrontend" as react
participant "AdminController" as ctrl
participant "ImportService" as svc
participant "ProductRepository" as repo
database "Database" as db

admin -> react : selectează fișierul CSV
react -> ctrl : POST /api/admin/import\n(MultipartFile)
ctrl -> ctrl : @PreAuthorize("hasRole('ADMIN')")
ctrl -> svc : importProductsFromCsv(file)
svc -> svc : parseCsvFile(file)
svc -> svc : validateRows(rows)

loop pentru fiecare rând valid
  svc -> svc : parseRow(row) → Product
end

svc -> repo : saveAll(List<Product>)
repo -> db : INSERT INTO products (batch)
db --> repo : List<Product> saved
repo --> svc : List<Product>
svc --> ctrl : ImportResultDTO\n{importedCount, errorCount, errors}
ctrl --> react : 200 OK {imported: N, errors: M}
react --> admin : afișează rezultatul importului

note right of svc
  Rândurile invalide sunt
  colectate în lista errors[]
  și raportate — fără a opri
  importul rândurilor valide
end note

@enduml
