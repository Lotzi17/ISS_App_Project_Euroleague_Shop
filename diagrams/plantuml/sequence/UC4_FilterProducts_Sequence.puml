@startuml UC4_FilterProducts_Sequence
skinparam backgroundColor #131313
skinparam sequenceArrowThickness 2
skinparam roundcorner 4
skinparam sequenceParticipantBorderColor #FF6B00
skinparam sequenceParticipantBackgroundColor #1f1f1f
skinparam sequenceParticipantFontColor #e2e2e2
skinparam sequenceParticipantFontStyle Bold
skinparam sequenceActorBorderColor #FF6B00
skinparam sequenceActorBackgroundColor #1f1f1f
skinparam sequenceActorFontColor #e2e2e2
skinparam sequenceArrowColor #FF6B00
skinparam sequenceLifeLineBorderColor #5a4136
skinparam noteBorderColor #FF6B00
skinparam noteBackgroundColor #2a2a2a
skinparam noteFontColor #e2bfb0
skinparam titleFontColor #FF6B00
skinparam titleFontSize 16
skinparam titleFontStyle Bold

title UC4 – Filter Products

actor User as user
participant "React\nFrontend" as react
participant "ProductController" as ctrl
participant "ProductService" as svc
participant "ProductRepository" as repo
database "Database" as db

user -> react : selectează filtre\n(categorie, echipă, preț maxim)
react -> ctrl : GET /api/products?category=X\n&team=Y&maxPrice=Z
ctrl -> svc : filterProducts(category, team, maxPrice, inStock)
svc -> repo : findByFilters(category, team, maxPrice, inStock)
repo -> db : SELECT * FROM products\nWHERE category=? AND team=?\nAND price<=?
db --> repo : List<Product>
repo --> svc : List<Product>
svc --> ctrl : List<ProductDTO>
ctrl --> react : 200 OK [filtered products]
react --> user : afișează produsele filtrate

note right of repo
  Query JPQL cu parametri opționali:
  parametru NULL = filtru ignorat
end note

@enduml
